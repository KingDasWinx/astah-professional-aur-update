post_install() {
	cat <<EOF
==> You have to purchase and install your license file to /usr/lib/astah-professional/
      ( you can get one at http://astah.net/pricing )
==> You can also use astah-uml for free with less functionality
==> Astah Professional 12 requires Java 25 (jre25-openjdk)
==> For PlantUML preview, install graphviz and set GRAPHVIZ_DOT=/usr/bin/dot if needed
EOF
}

post_upgrade() {
	post_install
}
